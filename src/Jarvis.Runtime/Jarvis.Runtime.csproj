<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    The always-on JARVIS runtime (jarvis-core.exe). It hosts the agent, background services,
    the local API (127.0.0.1 only) and the dashboard UI. It builds for two targets:
      - net10.0-windows…  the real product, with the Windows platform layer
      - net10.0           a cross-platform build used for development and tests
  -->
  <PropertyGroup>
    <TargetFrameworks>net10.0;$(JarvisWindowsTfm)</TargetFrameworks>
    <AssemblyName>jarvis-core</AssemblyName>
    <RootNamespace>Jarvis.Runtime</RootNamespace>
    <ApplicationIcon>..\..\assets\jarvis.ico</ApplicationIcon>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <PropertyGroup Condition="$(TargetFramework.Contains('-windows'))">
    <OutputType>WinExe</OutputType>
    <DefineConstants>$(DefineConstants);JARVIS_WINDOWS</DefineConstants>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jarvis.Core\Jarvis.Core.csproj" />
    <ProjectReference Include="..\Jarvis.Voice\Jarvis.Voice.csproj" />
  </ItemGroup>

  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <ProjectReference Include="..\Jarvis.Platform.Windows\Jarvis.Platform.Windows.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Jarvis.Runtime.Tests" />
  </ItemGroup>

</Project>
